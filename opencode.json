{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/johndee/.config/opencode/rules/*.md"
  ],
  "permission": {
    "read": {
      ".memory/**": "deny",
      ".plans/.old/**": "deny",
      "*": "allow"
    },
    "glob": {
      ".memory/**": "deny",
      ".plans/.old/**": "deny",
      "*": "allow"
    },
    "grep": {
      ".memory/**": "deny",
      ".plans/.old/**": "deny",
      "*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "websearch": "allow",
        "webfetch": "ask"
      }
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "websearch": "ask",
        "webfetch": "ask"
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "permission": {}
    },
    "summary": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
      "permission": {}
    },
    "general": {
      "model": "opencode-go/kimi-k2.7-code",
      "variant": "high",
      "permission": {}
    }
  },
  "command": {
    "git-commit": {
      "template": "Stage all changes with `git add -A`. Generate a concise commit message based on the diff. If the user provided a message as $ARGUMENTS, use that instead. Commit with `git commit -m \"<message>\"`. Then push to the remote with `git push`.",
      "description": "Stage, commit, and push all changes",
      "model": "opencode-go/deepseek-v4-flash",
      "subtask": true
    }
  },
  "plugin": [
    "@slkiser/opencode-quota",
  ],
  "experimental": {}
}
